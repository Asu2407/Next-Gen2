{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src/ index.html package.json vite.config.js"
}