{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "env": {
        "VITE_API_BASE_URL": "https://resqnet-backend.onrender.com"
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src/ index.html package.json vite.config.js vercel.json"
}