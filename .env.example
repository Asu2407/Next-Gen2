# Copy this file to .env.local for local overrides, or set these in your
# deployment platform's environment variable settings (e.g. Vercel project settings).

# Leave unset / empty for local development — Vite's dev proxy (see vite.config.js)
# forwards /api, /triage, /queue to http://127.0.0.1:8000 automatically.
#
# Once deployed (frontend on Vercel, backend on Render/Railway/Fly.io/etc.),
# set this to your backend's public URL, e.g.:
# VITE_API_BASE_URL=https://Sahayak-backend.onrender.com
VITE_API_BASE_URL=
